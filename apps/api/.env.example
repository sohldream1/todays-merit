DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todays_merit?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="tm_session"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# 32-byte hex key used to encrypt stored CRM integration credentials at rest
# (AES-256-GCM). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPTION_KEY="change-me-to-a-64-char-hex-string"

# Comma-separated emails allowed to log in as platform_admin (reviews
# nonprofit verification submissions at /dashboard/platform-admin). There's
# no signup form for this role — add an existing member/nonprofit account's
# email here to grant it. Leave unset to disable the role entirely.
PLATFORM_ADMIN_EMAILS=""

# Optional — only needed for a REAL Salesforce Connected App. Leave unset to
# run the Salesforce integration in mock mode (no real API calls).
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_REDIRECT_URI="http://localhost:4000/api/integrations/salesforce/callback"

# Optional — only needed for a REAL Blackbaud SKY API app (Raiser's Edge
# NXT). Leave unset to run that integration in mock mode. The subscription
# key comes from the Blackbaud developer portal, separate from the OAuth
# client id/secret.
BLACKBAUD_CLIENT_ID=""
BLACKBAUD_CLIENT_SECRET=""
BLACKBAUD_SUBSCRIPTION_KEY=""
BLACKBAUD_REDIRECT_URI="http://localhost:4000/api/integrations/raisers_edge_nxt/callback"

# Optional — only needed for a REAL Classy (GoFundMe Pro) API app. Leave
# unset to run that integration in mock mode. No redirect URI: Classy
# authenticates server-to-server (OAuth2 client_credentials), not via an
# admin consent redirect. defaultCampaignId is required for real donation
# syncing since Classy donations are campaign-scoped and this scaffold
# doesn't yet map individual Today's Merit campaigns to Classy campaign ids.
GOFUNDME_CLASSY_CLIENT_ID=""
GOFUNDME_CLASSY_CLIENT_SECRET=""
GOFUNDME_CLASSY_ORGANIZATION_ID=""
GOFUNDME_CLASSY_DEFAULT_CAMPAIGN_ID=""

# Optional — only needed for REAL Charity Navigator / Candid (GuideStar)
# lookups. Leave unset to use deterministic simulated ratings (stable per
# EIN, clearly labeled "(sample data)" in the UI).
CHARITY_NAVIGATOR_API_KEY=""
CANDID_API_KEY=""

# Optional — only needed for REAL transactional email (Resend:
# https://resend.com). Leave unset to log verification-workflow emails
# (submission/approval/rejection notices) to the console instead of sending
# them. EMAIL_FROM must be a domain verified in your Resend account once
# you do set a real key.
RESEND_API_KEY=""
EMAIL_FROM="Today's Merit <notifications@todaysmerit.example>"

# Optional — only needed for REAL AI-generated charity recommendations.
# This is your own Anthropic API key/billing, not anything ambient to
# Claude Code. Leave unset to use the transparent rule-based matching
# fallback (cause-area interest + rating) instead.
ANTHROPIC_API_KEY=""
